  <!--
    The application icon and the toolbar icons are rendered from SVG at
    build time by tools/svg2ico into $(IntDir)icons, which the resource
    compiler searches for the files that tvnviewer.rc names.

    The toolbar icons are drawn on 14- and 16-unit grids; extent 16 draws
    them at the same scale, one unit per pixel at 16 pixels. Their sizes
    are those of small icons from 100% to 400% scaling.
  -->
  <PropertyGroup>
	<!-- Outputs are independent of the Configuration and Platform,
		 so they can be included as Items in the Visual Studio IDE. -->
    <IntResDir>$(MSBuildThisFileDirectory)..\obj\res\</IntResDir>
    <Svg2IcoExe>$(OutDir)svg2ico.exe</Svg2IcoExe>
    <AppIconSvg>$(MSBuildProjectDirectory)\..\art\logo-publish.svg</AppIconSvg>
    <ToolbarIconSizes>16,20,24,28,32,40,48,56,64</ToolbarIconSizes>
  </PropertyGroup>
  <ItemGroup>
    <ToolbarIconSvg Include="..\art\toolbar\*.svg" />
    <UpToDateCheckInput Include="@(ToolbarIconSvg);$(Svg2IcoExe)" />
  </ItemGroup>
  <ItemDefinitionGroup>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)res;$(IntResDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <Target Name="RenderIcons" BeforeTargets="ResourceCompile"
          Inputs="$(AppIconSvg);$(Svg2IcoExe)" Outputs="$(IntResDir)SquirrelVNC.ico">
    <MakeDir Directories="$(IntResDir)" />
    <Exec Command="&quot;$(Svg2IcoExe)&quot; --ico &quot;$(IntResDir)SquirrelVNC.ico&quot; &quot;$(AppIconSvg)&quot;" />
  </Target>
  <Target Name="RenderToolbarIcons" BeforeTargets="ResourceCompile"
          Inputs="@(ToolbarIconSvg);$(Svg2IcoExe)"
          Outputs="@(ToolbarIconSvg->'$(IntResDir)%(Filename).ico')">
    <MakeDir Directories="$(IntResDir)" />
    <Exec Command="&quot;$(Svg2IcoExe)&quot; --sizes $(ToolbarIconSizes) --extent 16 --ico &quot;$(IntResDir)%(ToolbarIconSvg.Filename).ico&quot; &quot;%(ToolbarIconSvg.FullPath)&quot;" />
  </Target>

  <!-- Generate dialog resources from XML via WinDlgGen -->
  <PropertyGroup>
    <WinDlgGenDir>..\tools\WinDlgGen\</WinDlgGenDir>
    <WinDlgGenExe>$(WinDlgGenDir)out\bin\WinDlgGen\release\WinDlgGen.exe</WinDlgGenExe>
    <WinDlgGenOutputFile>$(IntResDir)WinDlgGenOutput.rc</WinDlgGenOutputFile>
  </PropertyGroup>
  <ItemGroup>
    <WinDlgGen Include="res\options-dialog.xml" />
    <WinDlgGen Include="res\authentication-dialog.xml" />
    <UpToDateCheckInput Include="@(WinDlgGen);res\preamble.h;$(WinDlgGenExe)" />
    <ResourceCompile Include="$(IntResDir)WinDlgGenOutput.rc" />
  </ItemGroup>
  <Target Name="EnsureWinDlgGen">
    <Error Condition="!Exists('$(WinDlgGenDir)src\WinDlgGen\WinDlgGen.csproj')" Text="WinDlgGen submodule is needed to generate Windows resource files, but is not checked out in the source tree" />
    <!-- Restore the tool's NuGet packages first, as the IDE would; a build
         from the command line does not.  Restore runs in an evaluation of its
         own, distinguished by a unique global property as NuGet recommends,
         so that the build which follows sees the restored package references. -->
    <MSBuild Projects="..\tools\WinDlgGen\src\WinDlgGen\WinDlgGen.csproj" Targets="Restore" Properties="Configuration=Release;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" RemoveProperties="Platform" />
    <MSBuild Projects="..\tools\WinDlgGen\src\WinDlgGen\WinDlgGen.csproj" Targets="Build" Properties="Configuration=Release" RemoveProperties="Platform" />
  </Target>
  <Target Name="GenerateDialogResources" BeforeTargets="ResourceCompile" DependsOnTargets="EnsureWinDlgGen"
          Inputs="@(WinDlgGen);res\preamble.h;$(WinDlgGenExe)"
          Outputs="$(WinDlgGenOutputFile)">
    <MakeDir Directories="$(IntResDir)" />
    <Message Text="Generating dialog resources from XML" Importance="High" />
    <Exec Command="&quot;$(WinDlgGenExe)&quot; -i res\preamble.h -o &quot;$(WinDlgGenOutputFile)&quot; @(WinDlgGen->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>

