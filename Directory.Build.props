<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Third-party libraries come from vcpkg in manifest mode (vcpkg.json next
    to this file). Uses the vcpkg in VCPKG_ROOT if set, otherwise the one
    bundled with Visual Studio. Static triplets (x64-windows-static,
    x86-windows-static) match the static CRT (/MT) these projects use.
  -->
  <PropertyGroup>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <TvnVcpkgMSBuildDir Condition="'$(VCPKG_ROOT)' != ''">$(VCPKG_ROOT)\scripts\buildsystems\msbuild\</TvnVcpkgMSBuildDir>
    <TvnVcpkgMSBuildDir Condition="'$(VCPKG_ROOT)' == ''">$(VsInstallRoot)\VC\vcpkg\scripts\buildsystems\msbuild\</TvnVcpkgMSBuildDir>

    <!-- These variables need defaults for OutDir, IntDir below, when
	 running on the command line where the user did not supply any setting.
	 The defaulting normally happens in Microsoft.Cpp.Default.props but that
	 occurs too late. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>

    <!-- Make sure output directories are consistent no matter whether
	 projects are built from the solution or the .vcxproj files directly. -->
    <OutDir>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
  <!--
    ReleaseAsan: the Release settings (projects test the configuration
    name with StartsWith('Release')) plus AddressSanitizer, for every
    project; see notes/testing.md. The ASan runtime DLL is copied next
    to each program (see Directory.Build.targets).
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseAsan'">
    <EnableASAN>true</EnableASAN>
  </PropertyGroup>
  <!--
    ReleaseFuzz: ReleaseAsan plus coverage instrumentation for libFuzzer
    (see Directory.Build.targets), for the libraries and rfb-fuzz only:
    code built this way links only into a program that has libFuzzer.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseFuzz'">
    <EnableASAN>true</EnableASAN>
  </PropertyGroup>
  <!--
    The Windows version targeted, defined for every file, as
    win32-lib/util/winhdr.h also defines it: Asio (from vcpkg) selects
    its features from _WIN32_WINNT, and must see the same value wherever
    it is included, also in files that do not include winhdr.h first.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>WINVER=0x0A00;_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <Import Project="$(TvnVcpkgMSBuildDir)vcpkg.props" />
</Project>
